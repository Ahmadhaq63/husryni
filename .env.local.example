# --- AI ---
# auto   = use Claude when ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN / ANTHROPIC_PROFILE is set, otherwise demo mode
# claude = always use Claude (also works with an `ant auth login` profile)
# mock   = always use the built-in demo analyzer (no API calls, fake findings, clearly labelled in the UI)
AI_MODE=auto
ANTHROPIC_API_KEY=
# Model settings are named AI_* on purpose: Claude Code exports CLAUDE_EFFORT to every terminal and
# process it starts, and a variable already set in the shell overrides this file.
AI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (defect spotting is judgement-heavy; "high" is the default)
AI_EFFORT=high
# Fast, low-cost model for the instant per-photo usability check
AI_FAST_MODEL=claude-haiku-5-5

# --- Inspector console ---
# Passcode for /inspector (prototype only — replace with real login, e.g. Auðkenni / island.is, before launch)
INSPECTOR_PASSCODE=change-me
# Any long random string; signs the inspector session cookie
SESSION_SECRET=replace-with-a-long-random-string

# --- Storage ---
# SQLite database + uploaded photos live here (default: ./data)
DATA_DIR=./data
